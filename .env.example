# Application
LOG_LEVEL=INFO
DEBUG=false

# HTTP server
SERVER_HOST=localhost
SERVER_PORT=8080
TRUST_PROXY_HEADERS=false

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=simpleblog
DB_PASSWORD=replace-with-a-strong-database-password
DB_NAME=simpleblog
DB_SSLMODE=disable
DB_SLOW_QUERY_MS=250

# JWT: production requires at least 32 characters
JWT_SECRET=replace-with-at-least-32-random-characters

# Cloudflare Turnstile
TURNSTILE_SITEKEY=replace-with-turnstile-site-key
TURNSTILE_SECRET=replace-with-turnstile-secret

# S3-compatible object storage; endpoint must not include http:// or https://
S3_ENDPOINT=localhost:9000
S3_REGION=us-east-1
S3_BUCKET=simpleblog
S3_ACCESS_KEY=replace-with-s3-access-key
S3_SECRET_KEY=replace-with-s3-secret-key
S3_USE_SSL=false
S3_PUBLIC_BASE_URL=http://localhost:9000/simpleblog

# Gravatar-compatible mirror base URL
GRAVATAR_BASE_URL=https://www.gravatar.com/avatar

